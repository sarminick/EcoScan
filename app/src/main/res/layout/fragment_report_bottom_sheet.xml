<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Arrastrador / Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="#D1D5DB" />

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reporte colaborativo de reciclaje"
            android:textColor="@color/unisimon_green_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ayúdanos a mantener actualizado el mapa ecológico del campus"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Selector de Tipo de Reporte -->
        <RadioGroup
            android:id="@+id/rgReportType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbNewPoint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Punto nuevo"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbRemovedPoint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Retirado"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbMovedPoint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Movido"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- Selector de Punto Existente (para retirado o movido) -->
        <LinearLayout
            android:id="@+id/layoutTargetPoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecciona el punto afectado *"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spExistingPoints"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Sección de Foto -->
        <LinearLayout
            android:id="@+id/layoutPhotoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivReportPhotoPreview"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="#E5E7EB"
                android:contentDescription="Foto del punto"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_camera"
                app:tint="@color/unisimon_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPhotoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foto real del punto *"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTakePhoto"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Capturar foto"
                    app:icon="@drawable/ic_camera" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sección GPS -->
        <LinearLayout
            android:id="@+id/layoutGpsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCoordinates"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Coordenadas GPS (Lat, Lng)"
                android:inputType="text"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGetGps"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Mi GPS"
                app:icon="@drawable/ic_nav_map" />
        </LinearLayout>

        <!-- Sede y Bloque -->
        <LinearLayout
            android:id="@+id/layoutSiteBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spSheetSite"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/spSheetBlock"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Punto de referencia / Ubicación descriptiva -->
        <EditText
            android:id="@+id/etSheetLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Punto de referencia (ej. Entrada principal, piso 2 junto a cafetín) *"
            android:inputType="textCapSentences"
            android:textSize="14sp" />

        <!-- Categorías aceptadas -->
        <TextView
            android:id="@+id/tvCategoriesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Categorías de reciclaje aceptadas:"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/hsvSheetCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMaterials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSheetPlastic"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plásticos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSheetPaper"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Papel y cartón" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSheetGlass"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vidrio" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSheetOrganic"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Orgánicos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSheetElectronics"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Electrónicos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSheetBulbs"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bombillas" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Descripción corta -->
        <EditText
            android:id="@+id/etSheetDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Descripción o notas adicionales (opcional)"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSheetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/unisimon_green_dark"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/pbSheetLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Botón enviar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitSheetReport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/unisimon_green"
            android:text="Enviar reporte colaborativo"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
