<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_light"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reportar punto" android:textColor="@color/unisimon_green_dark" android:textSize="26sp" android:textStyle="bold"/><TextView android:id="@+id/tvReportStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary"/>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardCornerRadius="20dp" android:backgroundTint="@color/surface_card"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ubicación" android:textStyle="bold" android:textColor="@color/text_primary"/>
<Spinner android:id="@+id/spSite" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp"/><Spinner android:id="@+id/spBlock" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp"/><EditText android:id="@+id/etFloor" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Piso o nivel (opcional)" android:inputType="text"/><EditText android:id="@+id/etLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ubicación exacta *" android:inputType="textCapSentences"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="20dp" android:backgroundTint="@color/surface_card"><LinearLayout android:id="@+id/chipMaterials" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Residuos aceptados *" android:textStyle="bold" android:textColor="@color/text_primary"/><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/chipPlastic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Plásticos"/><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/chipCaps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tapas de botellas"/><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/chipPaper" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Papel"/><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/chipCardboard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cartón"/><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/chipGlass" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vidrio"/><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/chipElectronics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Residuos electrónicos"/><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/chipBulbs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bombillas"/><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/chipOther" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Otros"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.button.MaterialButton android:id="@+id/btnSubmitReport" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:text="Enviar para aprobación"/>
</LinearLayout></ScrollView>
